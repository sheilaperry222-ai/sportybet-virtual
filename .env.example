# Supabase Config - Get from https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key-here
# For Python backend that writes, use service_role key (keep secret!)
SUPABASE_SERVICE_KEY=your-service-role-key

# SportyBet Bypass - Optional residential proxy to avoid IP bans
# Format: http://user:pass@host:port or http://host:port
# Free proxy list: https://www.proxy-list.download/HTTP
# Paid recommended: BrightData, Oxylabs, SmartProxy
PROXY_URL=
# Example: PROXY_URL=http://username:password@proxy.example.com:8000

# API URLs
# For local:
API_URL=http://localhost:8000
# For hosted frontend to call backend:
RENDER_API_URL=https://your-api.onrender.com
NETLIFY_API_URL=https://your-site.netlify.app

# SportyBet credentials (if you want auto-login in stealth collector)
SPORTYBET_PHONE=+234xxxxxxxxxx
SPORTYBET_PASSWORD=your_password
